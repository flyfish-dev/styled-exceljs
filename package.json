{
	"name": "styled-exceljs",
	"version": "0.21.5",
	"author": "sheetjs",
	"description": "SheetJS CE fork with enhanced XLS/XLSX styling and browser rendering",
	"keywords": [
		"excel",
		"xls",
		"xlsx",
		"xlsb",
		"xlsm",
		"ods",
		"csv",
		"dbf",
		"dif",
		"sylk",
		"office",
		"spreadsheet"
	],
	"bin": {
		"xlsx": "bin/xlsx.njs"
	},
	"main": "xlsx.js",
	"module": "xlsx.mjs",
	"unpkg": "dist/xlsx.full.min.js",
	"jsdelivr": "dist/xlsx.full.min.js",
	"types": "types/index.d.ts",
	"exports": {
		".": {
			"types": "./types/index.d.ts",
			"import": "./xlsx.mjs",
			"require": "./xlsx.js"
		},
		"./xlsx.mjs": {
			"types": "./types/index.d.ts",
			"import": "./xlsx.mjs"
		},
		"./xlsx.js": {
			"types": "./types/index.d.ts",
			"require": "./xlsx.js"
		},
		"./dist/xlsx.core.min": {
			"types": "./types/index.d.ts",
			"import": "./dist/xlsx.core.min.js",
			"require": "./dist/xlsx.core.min.js"
		},
		"./dist/xlsx.core.min.js": {
			"types": "./types/index.d.ts",
			"import": "./dist/xlsx.core.min.js",
			"require": "./dist/xlsx.core.min.js"
		},
		"./dist/xlsx.full.min": {
			"types": "./types/index.d.ts",
			"import": "./dist/xlsx.full.min.js",
			"require": "./dist/xlsx.full.min.js"
		},
		"./dist/xlsx.full.min.js": {
			"types": "./types/index.d.ts",
			"import": "./dist/xlsx.full.min.js",
			"require": "./dist/xlsx.full.min.js"
		},
		"./dist/xlsx.mini.min": {
			"types": "./types/index.d.ts",
			"import": "./dist/xlsx.mini.min.js",
			"require": "./dist/xlsx.mini.min.js"
		},
		"./dist/xlsx.mini.min.js": {
			"types": "./types/index.d.ts",
			"import": "./dist/xlsx.mini.min.js",
			"require": "./dist/xlsx.mini.min.js"
		},
		"./dist/xlsx.zahl": {
			"types": "./dist/zahl.d.ts",
			"import": "./dist/xlsx.zahl.mjs",
			"require": "./dist/xlsx.zahl.js"
		},
		"./dist/xlsx.zahl.mjs": {
			"types": "./dist/zahl.d.ts",
			"import": "./dist/xlsx.zahl.mjs"
		},
		"./dist/xlsx.zahl.js": {
			"types": "./dist/zahl.d.ts",
			"require": "./dist/xlsx.zahl.js"
		},
		"./dist/cpexcel": {
			"types": "./dist/cpexcel.d.ts",
			"import": "./dist/cpexcel.full.mjs",
			"require": "./dist/cpexcel.js"
		},
		"./dist/cpexcel.js": {
			"types": "./dist/cpexcel.d.ts",
			"require": "./dist/cpexcel.js"
		},
		"./dist/cpexcel.full": {
			"types": "./dist/cpexcel.d.ts",
			"import": "./dist/cpexcel.full.mjs",
			"require": "./dist/cpexcel.js"
		},
		"./dist/cpexcel.full.mjs": {
			"types": "./dist/cpexcel.d.ts",
			"import": "./dist/cpexcel.full.mjs"
		}
	},
	"browser": {
		"buffer": false,
		"crypto": false,
		"stream": false,
		"process": false,
		"fs": false
	},
	"sideEffects": false,
	"devDependencies": {
		"@sheetjs/uglify-js": "~2.7.3",
		"@types/node": "8.5.9",
		"acorn": "7.4.1",
		"adler-32": "~1.3.1",
		"alex": "^11.0.1",
		"blanket": "~1.2.3",
		"cfb": "~1.2.2",
		"codepage": "~1.15.0",
		"commander": "~2.17.1",
		"crc-32": "~1.2.2",
		"dtslint": "^0.1.2",
		"eslint": "7.23.0",
		"eslint-plugin-html": "^6.1.2",
		"eslint-plugin-json": "^2.1.2",
		"exit-on-epipe": "~1.0.1",
		"fflate": "^0.7.1",
		"jsdom": "^27.4.0",
		"mocha": "^11.8.0",
		"sinon": "^1.17.7",
		"ssf": "~0.11.2",
		"typescript": "2.2.0",
		"wmf": "~1.0.1",
		"word": "~0.3.0"
	},
	"overrides": {
		"diff": "8.0.3",
		"serialize-javascript": "7.0.5"
	},
	"repository": {
		"type": "git",
		"url": "https://git.sheetjs.com/SheetJS/sheetjs"
	},
	"scripts": {
		"test": "make travis",
		"test:security": "node tests/security-prototype-pollution.mjs",
		"test:table-styles": "node tests/table-styles.mjs",
		"test:cfb-minifat": "node tests/cfb-minifat.mjs && XLSX_TEST_MODULE=./xlsx.mjs node tests/cfb-minifat.mjs",
		"build": "make",
		"lint": "make fullint",
		"dtslint": "dtslint types"
	},
	"config": {
		"blanket": {
			"pattern": "xlsx.js"
		}
	},
	"alex": {
		"allow": [
			"chinese",
			"special",
			"simple",
			"just",
			"crash",
			"wtf",
			"holes"
		]
	},
	"homepage": "https://sheetjs.com/",
	"files": [
		"CHANGELOG.md",
		"LICENSE",
		"README.md",
		"bower.json",
		"package.json",
		"xlsx.js",
		"xlsx.mjs",
		"xlsxworker.js",
		"bin/xlsx.njs",
		"dist/LICENSE",
		"dist/*.mjs",
		"dist/*.js",
		"dist/*.map",
		"dist/*.d.ts",
		"docs/*.md",
		"types/index.d.ts",
		"types/tsconfig.json"
	],
	"bugs": {
		"url": "https://git.sheetjs.com/SheetJS/sheetjs/issues"
	},
	"license": "Apache-2.0",
	"engines": {
		"node": ">=0.8"
	}
}
